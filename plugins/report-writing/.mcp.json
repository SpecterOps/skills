{
  "mcp_servers": {
    "ghostwriter": {
      "command": "bash",
      "args": [
        "./scripts/run-ghostwriter-mcp.sh"
      ],
      "env_vars": [
        "GHOSTWRITER_MCP_DIR",
        "GHOSTWRITER_MCP_SOURCE",
        "GHOSTWRITER_URL",
        "GHOSTWRITER_API_KEY",
        "GHOSTWRITER_CA_BUNDLE",
        "GHOSTWRITER_OPLOG_ID",
        "GHOSTWRITER_OPERATOR",
        "GHOSTWRITER_SOURCE_IP",
        "GHOSTWRITER_MCP_AUTO_INSTALL",
        "GHOSTWRITER_MCP_UV_SYNC"
      ]
    }
  }
}
