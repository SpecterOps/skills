{
  "name": "bloodhound_mcp",
  "type": "stdio",
  "source": {
    "default": "https://github.com/mwnickerson/bloodhound_mcp.git",
    "override_env": "BLOODHOUND_MCP_SOURCE"
  },
  "run": {
    "command": "uv",
    "args": ["--directory", "/path/to/bloodhound-mcp", "run", "main.py"],
    "entrypoint": "main.py"
  },
  "secrets": [
    "BLOODHOUND_TOKEN_ID",
    "BLOODHOUND_TOKEN_KEY"
  ],
  "configuration": [
    "BLOODHOUND_DOMAIN",
    "BLOODHOUND_SCHEME",
    "BLOODHOUND_PORT"
  ]
}
