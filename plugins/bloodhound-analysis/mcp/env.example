# Copy this file to the BloodHound MCP server checkout as `.env`.
# Do not commit real credentials.

BLOODHOUND_DOMAIN=your-bloodhound-instance.domain.com
BLOODHOUND_TOKEN_ID=your-token-id
BLOODHOUND_TOKEN_KEY=your-token-key
BLOODHOUND_SCHEME=https
BLOODHOUND_PORT=443

# Optional first-run bootstrap controls.
# BLOODHOUND_MCP_AUTO_INSTALL=0
# BLOODHOUND_MCP_SOURCE=https://github.com/mwnickerson/bloodhound_mcp.git
# BLOODHOUND_MCP_UV_SYNC=0
