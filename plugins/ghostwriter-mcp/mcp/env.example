# Do not commit real credentials.

GHOSTWRITER_URL=https://ghostwriter.example.com/
GHOSTWRITER_API_KEY=your-api-key
GHOSTWRITER_CA_BUNDLE=/path/to/ca-bundle.crt

# Optional defaults used by ghostwriter-oplog.
GHOSTWRITER_OPLOG_ID=123
GHOSTWRITER_OPERATOR=your-callsign
GHOSTWRITER_SOURCE_IP=10.0.0.5

# Optional first-run bootstrap controls.
# GHOSTWRITER_MCP_AUTO_INSTALL=0
# GHOSTWRITER_MCP_SOURCE=https://github.com/SpecterOps/GhostWriterMCP.git
# GHOSTWRITER_MCP_UV_SYNC=0
