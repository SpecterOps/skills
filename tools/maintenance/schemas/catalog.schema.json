{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "plugins"],
  "properties": {
    "version": {"const": 1},
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "surfaces"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["codex", "claude"]}
          },
          "mcp": {"enum": ["Manual"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
